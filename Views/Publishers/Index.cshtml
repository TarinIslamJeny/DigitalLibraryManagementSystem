@model IEnumerable<DigitalLibraryManagementSystem.Models.Publisher>
@{
    ViewData["Title"] = "Publishers";
}

<div class="page-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h2 class="section-title mb-0">Publishers</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-action="Create" class="btn btn-primary">Add Publisher</a>
        }
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">No publishers have been added yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Name</th><th>Phone</th><th>Address</th></tr></thead>
                <tbody>
                    @foreach (var publisher in Model)
                    {
                        <tr><td class="fw-semibold">@publisher.Name</td><td>@publisher.Phone</td><td>@publisher.Address</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
