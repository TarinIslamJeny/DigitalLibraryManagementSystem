@model IEnumerable<DigitalLibraryManagementSystem.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="page-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h2 class="section-title mb-0">Notifications</h2>
        <span class="text-muted">@Model.Count() total</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">No notifications yet.</div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in Model)
            {
                <article class="notification-row @(notification.IsRead ? "" : "notification-unread")">
                    <div class="flex-grow-1">
                        <p class="mb-1">@notification.Message</p>
                        <small class="text-muted">@notification.CreatedAt.ToLocalTime().ToString("g")</small>
                    </div>
                    @if (!notification.IsRead)
                    {
                        <form asp-action="MarkAsRead" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="notificationId" value="@notification.NotificationId" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark as read</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge text-bg-light">Read</span>
                    }
                </article>
            }
        </div>
    }
</div>
