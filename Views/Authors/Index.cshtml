@model IEnumerable<DigitalLibraryManagementSystem.Models.Author>
@{
    ViewData["Title"] = "Authors";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">Authors</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-action="Create" class="btn btn-primary">Add Author</a>
        }
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12"><div class="empty-state">No authors have been added yet.</div></div>
        }
        @foreach (var author in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 p-3">
                    <h5 class="fw-bold">@author.Name</h5>
                    <p class="text-muted mb-0">@author.Biography</p>
                </div>
            </div>
        }
    </div>
</div>
