@model IEnumerable<DigitalLibraryManagementSystem.Models.Book>
@inject DigitalLibraryManagementSystem.Services.FileStorageService FileStorage
@{
    ViewData["Title"] = "Manage Books";
}

<div class="page-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h2 class="section-title mb-0">Manage Books</h2>
        <a asp-controller="Books" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Book</a>
    </div>
    <form asp-action="SearchBooks" method="get" class="row g-2 mb-4">
        <div class="col-sm-9 col-lg-10">
            <label for="query" class="visually-hidden">Search books</label>
            <input id="query" name="query" class="form-control" value="@Context.Request.Query["query"]" placeholder="Search title, ISBN, or author" />
        </div>
        <div class="col-sm-3 col-lg-2"><button type="submit" class="btn btn-primary w-100">Search</button></div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">No books found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Cover</th><th>Title</th><th>Author</th><th>Category</th><th>Copies</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td><img src="@FileStorage.GetCoverImagePath(book.CoverImagePath)" alt="@book.Title cover" class="table-book-cover" /></td>
                            <td>@book.Title</td>
                            <td>@book.Author?.Name</td>
                            <td>@book.Category?.Name</td>
                            <td>@book.AvailableCopies / @book.TotalCopies</td>
                            <td class="text-nowrap">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-primary">Details</a>
                                <a asp-controller="Books" asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
