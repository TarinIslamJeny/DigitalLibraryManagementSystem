@{
    ViewData["Title"] = "Return Book";
}

<div class="page-shell">
    <h2 class="section-title">Book Returns</h2>
    <div class="empty-state mb-4">Members can return checked-out books from their Profile. Review overdue loans or look up a member below.</div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Borrow" asp-action="OverdueBooks" class="btn btn-primary">Review Overdue Books</a>
        <a asp-action="SearchMember" class="btn btn-outline-primary">Find a Member</a>
    </div>
</div>
